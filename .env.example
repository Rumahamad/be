ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=bnc-payment-files
STORAGE_MAX_FILE_BYTES=5242880
# Legacy alternatives are also supported during Supabase's transition.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
AUTH_BYPASS_ENABLED=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
FRONTEND_URL=http://127.0.0.1:5173
# Add FRONTEND_URL/auth/set-password and FRONTEND_URL/auth/reset-password to
# Supabase Authentication -> URL Configuration -> Redirect URLs.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
EMAIL_PROVIDER=disabled
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=BNC
SMTP_REPLY_TO=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=30
EMAIL_APP_NAME=BNC
NOTIFICATION_MAX_ATTEMPTS=5
# Google Drive backup owner OAuth. Generate GOOGLE_TOKEN_ENCRYPTION_KEY with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/api/v1/admin/backups/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Optional guard: reject any connected Google account other than this address.
GOOGLE_OWNER_EMAIL=
# HDFC Gmail payment verification. Keep auto approval disabled during validation.
PAYMENT_AUTO_VERIFY_ENABLED=false
PAYMENT_AUTO_VERIFY_SHADOW_MODE=true
GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/api/v1/admin/payment-verification/google/callback
GMAIL_VERIFICATION_ACCOUNT_EMAIL=
GMAIL_HDFC_SEARCH_QUERY=
GMAIL_POLL_INTERVAL_SECONDS=60
HDFC_CREDIT_EMAIL_FROM=
HDFC_FORWARDER_EMAIL=
HDFC_EXPECTED_ACCOUNT_LAST4=
TESSERACT_CMD=
TESSERACT_LANGUAGE=eng
# Web Push (VAPID) -- generate with: python scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_PEM=
VAPID_SUBJECT=mailto:admin@bnc.pp.ua
